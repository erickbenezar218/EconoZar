# Copie para .env e troque a chave antes de subir o servidor.
API_KEY=troque-esta-chave

# Tickers da B3 no Yahoo Finance. Edite a lista. Isto é a sua cesta, não uma indicação de compra.
TICKERS=HGLG11.SA,MXRF11.SA,KNCR11.SA,PETR4.SA,VALE3.SA,ITUB4.SA

# BotFather gera o token. O chat id é o seu usuário (ou o id do grupo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Horário do resumo diário, America/Sao_Paulo.
DIGEST_HOUR=18
DIGEST_MINUTE=0

# Quanto tempo as cotações ficam em cache fora do pregão, em segundos.
CACHE_SECONDS=900

# Durante o pregão (dias úteis, 10h–17h, horário de Brasília) o servidor busca a cesta de novo.
SESSION_POLL_SECONDS=60

# Aviso no Telegram só se o preço andar este percentual desde o último alerta.
ALERT_MOVE_PERCENT=1.5

# Chave do Gemini, só neste servidor. O app não compra cripto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cotações públicas do Mercado Bitcoin. Sem ordem de compra.
CRYPTO_SYMBOLS=BTC-BRL,ETH-BRL
