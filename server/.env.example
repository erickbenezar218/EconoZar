# Copie para .env e troque a chave antes de subir o servidor.
API_KEY=troque-esta-chave

# Tickers da B3 no Yahoo Finance. Edite a lista. Isto é a sua cesta, não uma indicação de compra.
TICKERS=HGLG11.SA,MXRF11.SA,KNCR11.SA,PETR4.SA,VALE3.SA,ITUB4.SA

# BotFather gera o token. O chat id é o seu usuário (ou o id do grupo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Horário do resumo diário, America/Sao_Paulo.
DIGEST_HOUR=18
DIGEST_MINUTE=0

# Quanto tempo as cotações ficam em cache, em segundos.
CACHE_SECONDS=900
